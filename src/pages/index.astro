---
/**
 * A semantic, continuous one-page portfolio for fast scanning.
 *
 * Content remains server-rendered and readable without JavaScript. The
 * interactive site's background is reused as a progressively enhanced
 * visual layer, while the document itself stays linear and accessible.
 */
import Base from '@/layouts/Base.astro';
import { AiChat } from '@/components/ai/AiChat';
import { CosmicBackground } from '@/components/canvas/CosmicBackground';
import { CvPill } from '@/components/canvas/CvPill';
import ContactIcon from '@/components/plain/ContactIcon.astro';
import { doors } from '@/content/doors.data';
import { LAST_UPDATED_YEAR } from '@/content/site';
import type { ArtifactBlock } from '@/domain/artifact';
import type { DoorId } from '@/domain/door';
import '@/styles/global.css';

const DISPLAY_ORDER: readonly DoorId[] = [
  'about',
  'leadership',
  'engineering',
  'elsewhere',
];

const PLAIN_TAGLINE_OVERRIDES: Partial<Record<DoorId, string>> = {
  about: 'background · approach',
};

const sections = DISPLAY_ORDER
  .map((id) => doors.find((door) => door.id === id))
  .filter((door): door is NonNullable<typeof door> => door !== undefined);

const profile = doors
  .find((door) => door.id === 'about')
  ?.artifact.find((block) => block.kind === 'profileHeader');

function toTitle(name: string): string {
  return name.charAt(0) + name.slice(1).toLowerCase();
}

function isExternal(href: string): boolean {
  return /^https?:/.test(href);
}

function contactDisplay(href: string): string {
  return href.replace(/^(https?:\/\/(www\.)?|mailto:)/, '');
}

type MetricBlock = Extract<ArtifactBlock, { kind: 'metric' }>;

const LEADERSHIP_METRIC_ORDER = new Map<string, number>([
  ['+30%', 0],
  ['~380', 1],
  ['0', 2],
  ['<24h', 3],
  ['4', 4],
]);

function orderedMetrics(
  sectionId: DoorId,
  blocks: readonly ArtifactBlock[],
): readonly MetricBlock[] {
  const metrics = blocks.filter(
    (block): block is MetricBlock => block.kind === 'metric',
  );

  if (sectionId !== 'leadership') return metrics;

  return metrics.sort(
    (a, b) =>
      (LEADERSHIP_METRIC_ORDER.get(a.value) ?? Number.MAX_SAFE_INTEGER)
      - (LEADERSHIP_METRIC_ORDER.get(b.value) ?? Number.MAX_SAFE_INTEGER),
  );
}
---
<Base
  title="Borbála Szilágyi — Software Engineer · Team Lead"
  canonicalPath="/"
>
  <style is:global>
    html {
      scroll-behavior: smooth;
      scroll-padding-top: 92px;
    }

    /* `clip`, not `hidden`. Any overflow value except visible/clip turns
       body into a scroll container, and a sticky descendant then scrolls
       within *that* — which never scrolls, since body is as tall as its
       content. That silently killed the sticky section headers: the markup
       was there the whole time, it just never stuck. `clip` still contains
       horizontal overflow but leaves scrolling on the document, where the
       headers can travel.

       overflow-y must stay `visible !important`: global.css sets
       `body { overflow: hidden }` for the canvas, which this page also
       imports, so without the override the document cannot scroll at all.
       `visible` restores it without making body a scroll container — which
       `auto`, the previous value, quietly did. That pairing is what broke
       the sticky headers: the override was doing two jobs and only one of
       them was wanted. */
    body {
      overflow-x: clip;
      overflow-y: visible !important;
      min-height: 100dvh;
      background: #06060f;
    }
  </style>

  <div class="plain-space" aria-hidden="true">
    <CosmicBackground client:load />
  </div>

  <div class="plain-page">
    <a class="plain-skip" href="#profile">Skip to profile</a>

    <header class="plain-topbar">
      <div class="plain-topbar-inner">
        <a class="plain-brand" href="/interactive" aria-label="Open the interactive portfolio">
          <span class="plain-brand-name">Borbála Szilágyi</span>
          <span class="plain-brand-role">Software Engineer · Team Lead</span>
        </a>

        <nav
          class="plain-progress"
          aria-label="Profile sections"
          data-plain-progress
        >
          {sections.map((section) => (
            <a
              href={`#${section.id}`}
              data-plain-progress-link={section.id}
            >
              <span class="plain-progress-dot" aria-hidden="true"></span>
              <span>{toTitle(section.name)}</span>
            </a>
          ))}
        </nav>

        <nav class="plain-nav" aria-label="Primary">
          <a class="plain-nav-action plain-nav-ai" href="#ask-me">
            <span class="plain-nav-ai-dot" aria-hidden="true"></span>
            ASK ME
          </a>
          <CvPill
            client:load
            className="all-doors-header-cv plain-nav-cv"
          />
          <a class="plain-nav-action plain-nav-interactive" href="/interactive">
            interactive ↗
          </a>
        </nav>
      </div>
    </header>

    <main class="plain-main">
      <section class="plain-hero" aria-labelledby="plain-title">
        <div class="plain-hero-copy">
          <h1 id="plain-title">
            <span>Engineering systems.</span>
            <span>Growing engineers.</span>
          </h1>
          <p class="plain-hero-deck">
            Software engineer and team lead working across production systems,
            team delivery, and applied AI.
          </p>

          <form
            class="plain-hero-ask"
            data-hero-chat-submit
            aria-label="Ask the portfolio assistant"
          >
            <label for="plain-hero-question">
              <span>ASK ME</span>
            </label>
            <div class="plain-hero-ask-row">
              <input
                id="plain-hero-question"
                name="question"
                type="text"
                maxlength="250"
                autocomplete="off"
                {/* Terse on purpose: the label above already says ASK ME, so
                    the placeholder only has to name the territory. The full
                    sentence ran past the edge of a phone screen. */}
                placeholder="engineering, leadership, AI…"
                required
              />
              <button type="submit" aria-label="Send question to the assistant">
                <span aria-hidden="true">↘</span>
              </button>
            </div>
          </form>

          <p class="plain-hero-where">
            Budapest, Hungary · remote, timezone flexible
          </p>

          {profile?.kind === 'profileHeader' && (
            <div class="plain-hero-contacts" aria-label="Contact links">
              {profile.contacts.map((contact) => (
                <a
                  href={contact.href}
                  aria-label={contact.label}
                  target={isExternal(contact.href) ? '_blank' : undefined}
                  rel={isExternal(contact.href) ? 'noopener noreferrer' : undefined}
                >
                  <ContactIcon kind={contact.icon} />
                </a>
              ))}
            </div>
          )}
        </div>

        {profile?.kind === 'profileHeader' && (
          <div class="plain-portrait-orbit" aria-hidden="true">
            <div class="plain-orbit plain-orbit-one"></div>
            <div class="plain-orbit plain-orbit-two"></div>
            <span class="plain-orbit-star plain-orbit-star-one"></span>
            <span class="plain-orbit-star plain-orbit-star-two"></span>
            <img
              src={profile.photo.src}
              alt=""
              width="220"
              height="220"
            />
          </div>
        )}
      </section>

      <section class="plain-ai-spotlight" id="ask-me" aria-labelledby="plain-ai-title">
        <div class="plain-ai-intro">
          <p class="plain-ai-kicker">
            portfolio assistant
          </p>
          <h2 id="plain-ai-title">Skip the CV.<br />Ask the source.</h2>
          <p>
            Ask about my engineering work, leadership, or how I use AI in
            production — answers are grounded in this portfolio.
          </p>
        </div>

        <div class="plain-ai-console">
          <header class="plain-ai-console-header">
            <span class="plain-ai-console-title">ASK ME</span>
          </header>

          <div class="plain-ai-console-body">
            <AiChat client:load acceptExternalSubmit />
          </div>

        </div>
      </section>

      <article class="plain-document" id="profile" aria-label="Professional profile">
        {sections.map((section) => (
          <section
            class="plain-section"
            id={section.id}
            aria-labelledby={`plain-h-${section.id}`}
          >
            <header class="plain-section-rail">
              <div class="plain-section-rail-inner">
                <h2 id={`plain-h-${section.id}`}>{toTitle(section.name)}</h2>
                <p>{PLAIN_TAGLINE_OVERRIDES[section.id] ?? section.tagline}</p>
              </div>
            </header>

            <div class="plain-section-content">
              {section.artifact.map((block: ArtifactBlock, blockIndex) => {
                if (
                  block.kind === 'aiChat'
                  || block.kind === 'profileHeader'
                  || block.kind === 'photo'
                ) {
                  return null;
                }

                if (block.kind === 'heading') {
                  return <h3 class="plain-heading">{block.text}</h3>;
                }

                if (block.kind === 'paragraph') {
                  return <p class="plain-copy">{block.text}</p>;
                }

                if (block.kind === 'bullet') {
                  return (
                    <ul class="plain-bullets">
                      {block.items.map((item) => <li>{item}</li>)}
                    </ul>
                  );
                }

                if (block.kind === 'metric') {
                  const firstMetricIndex = section.artifact.findIndex(
                    (candidate) => candidate.kind === 'metric',
                  );
                  if (blockIndex !== firstMetricIndex) return null;

                  return (
                    <div class="plain-metric-grid" aria-label={`${toTitle(section.name)} metrics`}>
                      {orderedMetrics(section.id, section.artifact).map((metric, metricIndex) => (
                        <div class={`plain-metric plain-metric-${metricIndex + 1}`}>
                          <strong>{metric.value}</strong>
                          <span>{metric.label}</span>
                        </div>
                      ))}
                    </div>
                  );
                }

                if (block.kind === 'quote') {
                  return (
                    <blockquote class="plain-quote">
                      {block.text}
                      {block.attribution && <footer>— {block.attribution}</footer>}
                    </blockquote>
                  );
                }

                if (block.kind === 'sectionLabel') {
                  return <h3 class="plain-section-label">{block.text}</h3>;
                }

                if (block.kind === 'productList') {
                  return (
                    <ul class="plain-products">
                      {block.products.map((product) => (
                        <li>
                          <div class="plain-product-heading">
                            <strong>{product.name}</strong>
                            <span>{product.type}</span>
                          </div>
                          <p>{product.summary}</p>
                          <p class="plain-stack-line">{product.stack.join(' · ')}</p>
                        </li>
                      ))}
                    </ul>
                  );
                }

                if (block.kind === 'projectCard') {
                  const projectIndex = section.artifact
                    .slice(0, blockIndex)
                    .filter((candidate) => candidate.kind === 'projectCard')
                    .length;
                  const projectClass = [
                    'plain-project',
                    projectIndex === 0 ? 'plain-project-featured' : '',
                    projectIndex > 0 && projectIndex % 2 === 0
                      ? 'plain-project-reverse'
                      : '',
                  ].filter(Boolean).join(' ');

                  return (
                    <article class={projectClass}>
                      {block.preview && (
                        <a
                          class="plain-project-preview"
                          href={block.href}
                          target={isExternal(block.href) ? '_blank' : undefined}
                          rel={isExternal(block.href) ? 'noopener noreferrer' : undefined}
                          tabindex="-1"
                          aria-hidden="true"
                        >
                          <img
                            src={block.preview.src}
                            alt=""
                            width="480"
                            height="270"
                            loading="lazy"
                          />
                        </a>
                      )}
                      <div class="plain-project-copy">
                        <div class="plain-project-heading">
                          <h4>
                            <a
                              href={block.href}
                              target={isExternal(block.href) ? '_blank' : undefined}
                              rel={isExternal(block.href) ? 'noopener noreferrer' : undefined}
                            >
                              {block.name} <span aria-hidden="true">↗</span>
                            </a>
                          </h4>
                          {block.liveHref && (
                            <a
                              class="plain-live-link"
                              href={block.liveHref}
                              target="_blank"
                              rel="noopener noreferrer"
                            >
                              live · {contactDisplay(block.liveHref)}
                            </a>
                          )}
                        </div>
                        <p>{block.summary}</p>
                        {block.stack && block.stack.length > 0 && (
                          <ul class="plain-stack" aria-label="Technology stack">
                            {block.stack.map((technology) => <li>{technology}</li>)}
                          </ul>
                        )}
                      </div>
                    </article>
                  );
                }

                if (block.kind === 'postCard') {
                  return (
                    <a
                      class="plain-post"
                      href={block.href}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <span class="plain-post-main">
                        <strong>{block.title}</strong>
                        <em>“{block.quote}”</em>
                      </span>
                      <span class="plain-post-meta">
                        {block.publication ? `${block.publication} · ` : ''}
                        {block.date} ↗
                      </span>
                    </a>
                  );
                }

                if (block.kind === 'contactGroup') {
                  return (
                    <ul class="plain-contact-list">
                      {block.contacts.map((contact) => (
                        <li>
                          <a
                            href={contact.href}
                            target={isExternal(contact.href) ? '_blank' : undefined}
                            rel={isExternal(contact.href) ? 'noopener noreferrer' : undefined}
                          >
                            {contactDisplay(contact.href)} ↗
                          </a>
                        </li>
                      ))}
                    </ul>
                  );
                }

                return null;
              })}
            </div>
          </section>
        ))}
      </article>

      <footer class="plain-footer">
        <span>updated · {LAST_UPDATED_YEAR}</span>
      </footer>
    </main>
  </div>
</Base>

<script>
  import { publishChatSubmit } from '@/services/chat-prefill';

  const heroChatForm =
    document.querySelector<HTMLFormElement>('[data-hero-chat-submit]');

  heroChatForm?.addEventListener('submit', (event) => {
    event.preventDefault();

    const data = new FormData(heroChatForm);
    const rawQuestion = data.get('question');
    if (typeof rawQuestion !== 'string') return;

    const question = rawQuestion.trim();
    if (!question) return;

    const input = heroChatForm.elements.namedItem('question');
    const submit = heroChatForm.querySelector<HTMLButtonElement>('button[type="submit"]');
    const target = document.querySelector<HTMLElement>('#ask-me');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    heroChatForm.classList.remove('is-sending');
    void heroChatForm.offsetWidth;
    heroChatForm.classList.add('is-sending');
    heroChatForm.setAttribute('aria-busy', 'true');
    if (input instanceof HTMLInputElement) {
      input.disabled = true;
      input.value = '';
    }
    if (submit) submit.disabled = true;

    publishChatSubmit(question);
    target?.scrollIntoView({
      behavior: reduceMotion ? 'auto' : 'smooth',
      block: 'start',
    });

    window.setTimeout(() => {
      heroChatForm.classList.remove('is-sending');
      heroChatForm.removeAttribute('aria-busy');
      if (input instanceof HTMLInputElement) input.disabled = false;
      if (submit) submit.disabled = false;
    }, reduceMotion ? 0 : 900);
  });

  const progressLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('[data-plain-progress-link]'),
  );

  /* Only the active-section highlight is observed now. The nav used to fade
     itself in once the profile scrolled into view — it lived in the margin
     and had to announce itself. In the header it is simply always there. */
  if (progressLinks.length > 0 && 'IntersectionObserver' in window) {
    const sectionObserver = new IntersectionObserver(
      (entries) => {
        const activeEntry = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        const activeId = activeEntry?.target.id;
        if (!activeId) return;

        progressLinks.forEach((link) => {
          const isActive = link.dataset.plainProgressLink === activeId;
          link.classList.toggle('is-active', isActive);
          if (isActive) {
            link.setAttribute('aria-current', 'location');
          } else {
            link.removeAttribute('aria-current');
          }
        });
      },
      {
        rootMargin: '-24% 0px -58% 0px',
        threshold: [0, 0.25, 0.5, 0.75, 1],
      },
    );

    progressLinks.forEach((link) => {
      const sectionId = link.dataset.plainProgressLink;
      const section = sectionId
        ? document.getElementById(sectionId)
        : null;
      if (section) sectionObserver.observe(section);
    });
  }
</script>

<style>
  .plain-page {
    position: relative;
    z-index: 1;
    min-height: 100dvh;
    color: var(--text-bright);
  }

  /* The animated background is fixed behind a scrolling document, which on
     a phone means the browser repaints it against every frame of content
     movement. Giving it its own compositor layer lets the page scroll over
     a texture that is already rasterised, which is the difference between
     this and the canvas's see-all view — that one scrolls a contained
     element, so the background never enters the equation. */
  .plain-space {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0.88;
    will-change: transform;
    transform: translateZ(0);
    contain: strict;
  }

  .plain-space :global(astro-island) {
    position: absolute;
    inset: 0;
    display: block;
  }

  .plain-space::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(6, 6, 15, 0.05), rgba(6, 6, 15, 0.52)),
      radial-gradient(circle at 50% 48%, transparent 25%, rgba(6, 6, 15, 0.42) 100%);
  }

  .plain-skip {
    position: fixed;
    z-index: 100;
    top: 8px;
    left: 8px;
    padding: 8px 12px;
    color: var(--bg-deep);
    background: var(--accent-cyan);
    font-family: var(--font-mono);
    font-size: 11px;
    text-decoration: none;
    transform: translateY(-150%);
    transition: transform var(--d-fast) var(--ease-out);
  }

  .plain-skip:focus {
    transform: translateY(0);
  }

  .plain-topbar {
    position: sticky;
    top: 0;
    z-index: 20;
    /* Matches the canvas stack header: fades to fully transparent with no
       bottom rule, so content passes under it instead of hitting an edge.
       This bar used to stop at 0.68 alpha over a hairline border, which
       read as a solid toolbar rather than the same fading treatment. */
    background:
      linear-gradient(
        180deg,
        rgba(6, 6, 15, 0.98) 0%,
        rgba(6, 6, 15, 0.92) 55%,
        rgba(6, 6, 15, 0) 100%
      );
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  /* Three groups now — brand, section jumps, actions — so the gap is smaller
     than it was for two, and the section nav takes the slack instead of one
     wide void in the middle. */
  .plain-topbar-inner {
    width: min(100% - 40px, 1200px);
    min-height: 68px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .plain-brand {
    display: flex;
    flex-direction: column;
    min-width: max-content;
    color: inherit;
    text-decoration: none;
  }

  /* Sized to match .all-doors-header-name / -title on the canvas — the same
     identity block rendered at two different scales read as two different
     sites. */
  .plain-brand-name {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.03em;
  }

  .plain-brand-role {
    margin-top: 4px;
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
  }

  .plain-nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 6px;
    /* Holds the actions against the right edge whether or not the section
       nav is rendered at this width. */
    margin-left: auto;
    font-family: var(--font-mono);
  }

  .plain-nav a {
    color: var(--text-dim);
    font-size: 10px;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition:
      color var(--d-fast) var(--ease-out),
      border-color var(--d-fast) var(--ease-out),
      background var(--d-fast) var(--ease-out);
  }

  .plain-nav a:hover {
    color: var(--text-bright);
  }

  .plain-nav-action {
    margin-left: 4px;
    padding: 6px 9px;
    border: 1px solid rgba(95, 184, 214, 0.34);
    border-radius: 4px;
    color: var(--accent-cyan) !important;
    background: rgba(13, 18, 48, 0.5);
  }

  .plain-nav-action:hover {
    border-color: rgba(178, 212, 229, 0.72);
    background: rgba(40, 52, 88, 0.66);
  }

  .plain-nav :global(.plain-nav-cv) {
    flex: 0 0 auto;
  }

  .plain-nav :global(.plain-nav-cv a) {
    font-size: inherit;
    letter-spacing: inherit;
  }

  .plain-nav-ai {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--accent-warm) !important;
    border-color: rgba(236, 200, 117, 0.5);
    background: rgba(236, 200, 117, 0.07);
    box-shadow: 0 0 16px rgba(236, 200, 117, 0.08);
  }

  .plain-nav-ai:hover {
    color: #ffe5a6 !important;
    border-color: rgba(236, 200, 117, 0.86);
    background: rgba(236, 200, 117, 0.14);
  }

  .plain-nav-ai-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent-warm);
    box-shadow: 0 0 8px var(--accent-warm);
    animation: plain-signal 2.4s ease-in-out infinite;
  }

  .plain-nav-interactive {
    color: #06131b !important;
    border-color: var(--accent-cyan);
    background: var(--accent-cyan);
    box-shadow: 0 0 18px rgba(95, 184, 214, 0.22);
    font-weight: 600;
  }

  .plain-nav-interactive:hover {
    color: #06131b !important;
    border-color: #a6e2f4;
    background: #83cbe3;
  }

  /* Section jumps live in the header, beside the brand. They used to be a
     fixed rail floating in the left margin, which only had room to exist
     above 1400px — so on every laptop the page had no way back to a section
     except scrolling. In the bar they are always there, and there is only
     one of them to reason about.

     Hidden below 900px: the bar already carries three controls on a phone
     and a second row of four more turns it into a menu. */
  .plain-progress {
    display: none;
    align-items: center;
    gap: 18px;
    margin-left: 8px;
    font-family: var(--font-mono);
  }

  @media (min-width: 900px) {
    .plain-progress {
      display: flex;
    }
  }

  .plain-progress a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--text-faint);
    font-size: 10px;
    letter-spacing: 0.05em;
    text-decoration: none;
    text-transform: lowercase;
    transition: color var(--d-fast) var(--ease-out);
  }

  .plain-progress-dot {
    width: 5px;
    height: 5px;
    flex: 0 0 auto;
    border: 1px solid rgba(95, 184, 214, 0.42);
    border-radius: 50%;
    background: transparent;
    transition:
      border-color var(--d-fast) var(--ease-out),
      background var(--d-fast) var(--ease-out),
      box-shadow var(--d-fast) var(--ease-out);
  }

  .plain-progress a:hover,
  .plain-progress a.is-active {
    color: var(--text-bright);
  }

  .plain-progress a.is-active .plain-progress-dot {
    border-color: var(--accent-warm);
    background: var(--accent-warm);
    box-shadow: 0 0 10px rgba(236, 200, 117, 0.7);
  }

  .plain-main {
    width: min(100% - 40px, 1200px);
    margin: 0 auto;
  }

  .plain-hero {
    min-height: calc(100svh - 68px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, min(30vw, 48svh, 390px));
    gap: clamp(28px, 6vw, 100px);
    align-items: center;
    padding: clamp(34px, 7svh, 80px) clamp(8px, 3vw, 36px);
  }

  .plain-hero-copy {
    max-width: 760px;
  }

  .plain-hero h1 {
    max-width: 780px;
    margin: 0;
    font-size: clamp(44px, min(7vw, 12svh), 92px);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.055em;
    text-wrap: balance;
    text-shadow: 0 0 36px rgba(178, 212, 229, 0.12);
  }

  .plain-hero h1 span {
    display: block;
    white-space: nowrap;
  }

  .plain-hero-deck {
    max-width: 650px;
    margin: 22px 0 0;
    color: #9fb1cf;
    font-size: clamp(16px, 2vw, 21px);
    line-height: 1.65;
    text-wrap: balance;
  }

  .plain-hero-ask {
    max-width: 660px;
    margin: 22px 0 0;
  }

  .plain-hero-ask > label {
    display: block;
    margin: 0 0 8px 2px;
    color: var(--accent-warm);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.14em;
  }

  .plain-hero-ask-row {
    position: relative;
    display: flex;
    align-items: stretch;
    overflow: hidden;
    border: 1px solid rgba(178, 212, 229, 0.3);
    border-radius: 10px;
    background:
      linear-gradient(110deg, rgba(8, 11, 31, 0.92), rgba(13, 18, 48, 0.8));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.05),
      0 18px 48px rgba(0, 0, 0, 0.26),
      0 0 28px rgba(95, 184, 214, 0.06);
    transition:
      border-color var(--d-fast) var(--ease-out),
      box-shadow var(--d-fast) var(--ease-out);
  }

  .plain-hero-ask-row::after {
    content: '';
    position: absolute;
    z-index: 3;
    top: 0;
    bottom: 0;
    left: -42%;
    width: 34%;
    opacity: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, transparent, rgba(236, 200, 117, 0.5), transparent);
    transform: skewX(-18deg);
  }

  .plain-hero-ask:focus-within .plain-hero-ask-row {
    border-color: rgba(236, 200, 117, 0.76);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 0 0 1px rgba(236, 200, 117, 0.07),
      0 20px 52px rgba(0, 0, 0, 0.3),
      0 0 34px rgba(236, 200, 117, 0.12);
  }

  .plain-hero-ask.is-sending .plain-hero-ask-row::after {
    animation: plain-send-pulse 780ms var(--ease-out) both;
  }

  .plain-hero-ask input {
    position: relative;
    z-index: 1;
    min-width: 0;
    min-height: 56px;
    flex: 1 1 auto;
    padding: 13px 18px;
    border: 0;
    outline: none;
    color: var(--text-bright);
    background: transparent;
    font-family: var(--font-sans);
    font-size: var(--fs-input);
    line-height: 1.4;
  }

  .plain-hero-ask input::placeholder {
    color: #62708d;
  }

  /* A round send key sitting inside the field, rather than a slab welded to
     its edge. The control is a chat composer, so it should look like one —
     and the old 104px block was the loudest element in the hero, competing
     with the headline. Icon-only keeps the arrow's meaning (the answer
     appears further down the page) and hands ~70px back to the input on
     phones. */
  .plain-hero-ask button {
    position: relative;
    z-index: 1;
    flex: 0 0 auto;
    align-self: center;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    margin-right: 9px;
    padding: 0;
    border: 1px solid rgba(236, 200, 117, 0.55);
    border-radius: 50%;
    color: var(--accent-warm);
    background: rgba(236, 200, 117, 0.1);
    font-size: 15px;
    line-height: 1;
    transition:
      color var(--d-fast) var(--ease-out),
      border-color var(--d-fast) var(--ease-out),
      background var(--d-fast) var(--ease-out),
      box-shadow var(--d-fast) var(--ease-out);
  }

  /* Solid only on intent — the field stays calm until the visitor engages
     with it, then the key reads as the obvious next step. */
  .plain-hero-ask button:hover:not(:disabled),
  .plain-hero-ask:focus-within button:not(:disabled) {
    color: #181204;
    border-color: transparent;
    background:
      linear-gradient(135deg, #f7d887, var(--accent-warm));
    box-shadow: 0 0 20px rgba(236, 200, 117, 0.28);
  }

  .plain-hero-ask input:disabled,
  .plain-hero-ask button:disabled {
    cursor: wait;
    opacity: 0.72;
  }

  /* Location and working mode belong with the contact cluster — it's the
     practical "where and how" a visitor wants next to the links, rather
     than something to hunt for in the profile prose. */
  .plain-hero-where {
    margin: 16px 0 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--text-dim);
  }

  .plain-hero-contacts {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 10px;
  }

  .plain-hero-contacts a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 1px solid rgba(95, 184, 214, 0.36);
    border-radius: 7px;
    color: var(--accent-cyan);
    background: rgba(13, 18, 48, 0.5);
    text-decoration: none;
    transition:
      color var(--d-fast) var(--ease-out),
      border-color var(--d-fast) var(--ease-out),
      background var(--d-fast) var(--ease-out),
      transform var(--d-fast) var(--ease-out);
  }

  .plain-hero-contacts a:hover {
    transform: translateY(-2px);
    color: var(--text-bright);
    border-color: rgba(178, 212, 229, 0.72);
    background: rgba(40, 52, 88, 0.68);
  }

  .plain-portrait-orbit {
    position: relative;
    width: clamp(220px, min(29vw, 48svh), 390px);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    justify-self: end;
    filter: drop-shadow(0 0 48px rgba(95, 184, 214, 0.14));
  }

  .plain-portrait-orbit::before {
    content: '';
    position: absolute;
    width: 62%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: rgba(95, 184, 214, 0.12);
    filter: blur(28px);
  }

  .plain-portrait-orbit::after {
    content: '';
    position: absolute;
    z-index: 4;
    inset: 9%;
    border-top: 1px solid rgba(236, 200, 117, 0.78);
    border-right: 1px solid rgba(95, 184, 214, 0.5);
    border-radius: 50%;
    clip-path: polygon(46% 0, 100% 0, 100% 58%, 76% 51%, 58% 20%);
    filter: drop-shadow(0 0 7px rgba(236, 200, 117, 0.28));
    pointer-events: none;
    transform: rotate(-9deg);
  }

  .plain-portrait-orbit img {
    position: relative;
    z-index: 2;
    width: 64%;
    height: 64%;
    object-fit: cover;
    border: 1px solid rgba(178, 212, 229, 0.7);
    border-radius: 50%;
    transform: translate(4%, -2%);
    box-shadow:
      0 0 0 8px rgba(13, 18, 48, 0.8),
      0 0 0 9px rgba(95, 184, 214, 0.18),
      -12px 18px 54px rgba(0, 0, 0, 0.42),
      0 0 52px rgba(95, 184, 214, 0.26);
  }

  .plain-orbit {
    position: absolute;
    z-index: 1;
    border: 1px solid rgba(95, 184, 214, 0.22);
    border-radius: 50%;
  }

  .plain-orbit-one {
    inset: 9%;
    border-left-color: rgba(236, 200, 117, 0.7);
    animation: plain-orbit-spin 26s linear infinite;
  }

  .plain-orbit-two {
    inset: 0;
    border-top-color: rgba(178, 212, 229, 0.55);
    border-bottom-color: transparent;
    animation: plain-orbit-spin 42s linear infinite reverse;
  }

  .plain-orbit-star {
    position: absolute;
    z-index: 3;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent-warm);
    box-shadow: 0 0 12px var(--accent-warm);
  }

  .plain-orbit-star-one {
    top: 17%;
    right: 15%;
  }

  .plain-orbit-star-two {
    bottom: 8%;
    left: 39%;
    width: 3px;
    height: 3px;
    background: var(--accent-cyan);
    box-shadow: 0 0 10px var(--accent-cyan);
  }

  .plain-ai-spotlight {
    position: relative;
    display: grid;
    grid-template-columns: minmax(260px, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
    margin: 0 0 28px;
    padding: clamp(28px, 4vw, 52px);
    overflow: hidden;
    border: 1px solid rgba(236, 200, 117, 0.34);
    border-radius: 18px;
    background:
      radial-gradient(circle at 10% 15%, rgba(236, 200, 117, 0.09), transparent 34%),
      radial-gradient(circle at 90% 90%, rgba(95, 184, 214, 0.12), transparent 38%),
      linear-gradient(145deg, rgba(15, 17, 43, 0.96), rgba(6, 6, 15, 0.96));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.07),
      0 0 0 1px rgba(236, 200, 117, 0.05),
      0 0 44px rgba(236, 200, 117, 0.1),
      0 42px 110px rgba(0, 0, 0, 0.52);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .plain-ai-spotlight::before {
    content: '';
    position: absolute;
    top: 0;
    left: 6%;
    right: 6%;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(236, 200, 117, 0.9),
      rgba(95, 184, 214, 0.85),
      transparent
    );
    box-shadow:
      0 0 14px rgba(236, 200, 117, 0.7),
      0 0 32px rgba(95, 184, 214, 0.35);
  }

  .plain-ai-spotlight::after {
    content: 'AI';
    position: absolute;
    right: -16px;
    bottom: -72px;
    color: rgba(178, 212, 229, 0.025);
    font-family: var(--font-mono);
    font-size: clamp(190px, 24vw, 330px);
    font-weight: 600;
    letter-spacing: -0.12em;
    line-height: 1;
    pointer-events: none;
  }

  .plain-ai-intro,
  .plain-ai-console {
    position: relative;
    z-index: 1;
  }

  .plain-ai-kicker {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 16px;
    color: var(--accent-warm);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .plain-ai-kicker::before {
    content: '';
    width: 5px;
    height: 5px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--accent-warm);
    box-shadow: 0 0 8px var(--accent-warm);
    animation: plain-signal 2.4s ease-in-out infinite;
  }

  .plain-ai-intro h2 {
    margin: 0;
    font-size: clamp(34px, 4.4vw, 58px);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1.02;
    text-wrap: balance;
  }

  .plain-ai-intro > p:not(.plain-ai-kicker) {
    margin: 18px 0 0;
    color: #afc1d9;
    font-size: 14px;
    line-height: 1.62;
  }

  .plain-ai-console {
    overflow: hidden;
    border: 1px solid rgba(178, 212, 229, 0.28);
    border-radius: 12px;
    background:
      linear-gradient(180deg, rgba(13, 18, 48, 0.96), rgba(6, 8, 24, 0.92));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 0 0 1px rgba(95, 184, 214, 0.05),
      0 20px 55px rgba(0, 0, 0, 0.4),
      0 0 36px rgba(95, 184, 214, 0.09);
  }

  .plain-ai-console-header {
    min-height: 50px;
    display: flex;
    align-items: center;
    padding: 12px 18px;
    border-bottom: 1px solid rgba(178, 212, 229, 0.13);
    background:
      linear-gradient(180deg, rgba(40, 52, 88, 0.42), rgba(13, 18, 48, 0.18));
    font-family: var(--font-mono);
  }

  .plain-ai-console-title {
    color: var(--accent-cyan);
    font-size: 11px;
    letter-spacing: 0.11em;
  }

  .plain-ai-console-body {
    min-height: 280px;
    padding: 14px 18px 16px;
  }

  .plain-ai-console-body :global(.chat-shell) {
    margin: 0 !important;
  }

  .plain-ai-console-body :global(.chat-log p:has(+ .chat-suggestions)) {
    display: none;
  }

  .plain-ai-console-body :global(.chat-log > div:has(> .chat-suggestions)) {
    padding-top: 4px !important;
  }

  .plain-ai-console-body :global(.chat-suggestion) {
    border-color: rgba(236, 200, 117, 0.32);
    color: #dcc888;
    background: rgba(236, 200, 117, 0.055);
  }

  .plain-ai-console-body :global(.chat-suggestion:hover) {
    border-color: rgba(236, 200, 117, 0.66);
    background: rgba(236, 200, 117, 0.12);
  }

  .plain-ai-console-body :global(.chat-composer-input) {
    border-color: rgba(95, 184, 214, 0.34) !important;
    box-shadow: inset 0 0 24px rgba(95, 184, 214, 0.025);
  }

  .plain-ai-console-body :global(.chat-composer-send) {
    color: #06131b !important;
    border-color: var(--accent-cyan) !important;
    background: var(--accent-cyan) !important;
    font-weight: 600;
  }

  .plain-document {
    position: relative;
    overflow: clip;
    border: 1px solid rgba(178, 212, 229, 0.3);
    border-radius: 16px;
    background:
      linear-gradient(180deg, rgba(13, 18, 48, 0.92), rgba(6, 6, 15, 0.94)),
      rgba(6, 6, 15, 0.9);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.07),
      0 0 0 1px rgba(178, 212, 229, 0.06),
      0 0 40px rgba(95, 184, 214, 0.12),
      0 40px 100px rgba(0, 0, 0, 0.48);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .plain-document::before {
    content: '';
    position: absolute;
    z-index: 2;
    top: 0;
    left: 5%;
    right: 5%;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(95, 184, 214, 0.85),
      rgba(236, 200, 117, 0.55),
      transparent
    );
    box-shadow: 0 0 18px rgba(95, 184, 214, 0.7);
  }

  .plain-section {
    display: grid;
    grid-template-columns: minmax(170px, 240px) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 70px);
    padding: clamp(36px, 5vw, 64px) clamp(24px, 5vw, 70px);
    border-top: 1px solid rgba(178, 212, 229, 0.13);
  }

  .plain-document > .plain-section:first-child {
    border-top: 0;
  }

  .plain-section-rail {
    min-width: 0;
  }

  .plain-section-rail-inner {
    position: sticky;
    top: 102px;
  }

  .plain-section-rail h2 {
    margin: 0;
    color: var(--accent-cyan);
    font-family: var(--font-mono);
    font-size: clamp(18px, 2vw, 24px);
    font-weight: 500;
    letter-spacing: 0.13em;
    line-height: 1.2;
    text-transform: lowercase;
  }

  .plain-section-rail p {
    margin: 10px 0 0;
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    line-height: 1.5;
  }

  .plain-section-content {
    min-width: 0;
    max-width: 850px;
  }

  .plain-heading {
    margin: 0 0 14px;
    font-size: clamp(22px, 3vw, 32px);
    line-height: 1.2;
  }

  /* pretty, not balance: it only reflows the last few lines to kill orphans
     and short tail lines, leaving the paragraph's measure alone. `balance`
     would even out every line and visibly narrow long paragraphs. */
  .plain-copy {
    margin: 0 0 18px;
    color: #c1d3ea;
    font-size: clamp(15px, 1.5vw, 17px);
    line-height: 1.78;
    text-wrap: pretty;
  }

  .plain-bullets {
    margin: 26px 0 0;
    padding: 0;
    list-style: none;
  }

  .plain-bullets li {
    position: relative;
    padding: 12px 0 12px 24px;
    border-top: 1px solid rgba(178, 212, 229, 0.1);
    color: #b3c6df;
    line-height: 1.65;
  }

  .plain-bullets li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--accent-cyan);
    font-family: var(--font-mono);
  }

  .plain-metric-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-rows: minmax(108px, auto);
    gap: 10px;
    margin: 24px 0 0;
  }

  .plain-metric {
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 16px;
    border: 1px solid rgba(178, 212, 229, 0.14);
    border-radius: 9px;
    background:
      linear-gradient(145deg, rgba(95, 184, 214, 0.07), rgba(13, 18, 48, 0.28));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  .plain-metric-1 {
    grid-column: span 5;
    grid-row: span 2;
    padding: 22px;
    border-color: rgba(236, 200, 117, 0.36);
    background:
      radial-gradient(circle at 90% 12%, rgba(236, 200, 117, 0.13), transparent 38%),
      linear-gradient(145deg, rgba(236, 200, 117, 0.1), rgba(13, 18, 48, 0.38));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 0 28px rgba(236, 200, 117, 0.07);
  }

  .plain-metric-2 {
    grid-column: span 4;
  }

  .plain-metric-3 {
    grid-column: span 3;
  }

  .plain-metric-4 {
    grid-column: span 3;
  }

  .plain-metric-5 {
    grid-column: span 4;
  }

  .plain-metric strong {
    color: var(--accent-cyan);
    font-size: 27px;
    font-weight: 600;
    line-height: 1;
  }

  .plain-metric span {
    margin-top: 14px;
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.04em;
    line-height: 1.4;
  }

  .plain-metric-1 strong {
    color: var(--accent-warm);
    font-size: clamp(42px, 5vw, 62px);
  }

  .plain-metric-1 span {
    max-width: none;
    color: #c9b97e;
    font-size: 11px;
    white-space: nowrap;
  }

  /* Sized for a short stack rather than one big pull-quote: four of these
     sit together, so the type is smaller and the margins tight enough that
     they read as one block of evidence instead of four decorations. */
  .plain-quote {
    margin: 14px 0;
    padding: 2px 0 2px 18px;
    border-left: 2px solid var(--accent-violet);
    color: #bed2e8;
    font-size: 15px;
    font-style: italic;
    line-height: 1.65;
  }

  .plain-quote footer {
    margin-top: 8px;
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 10px;
    font-style: normal;
  }

  .plain-section-label {
    margin: 38px 0 14px;
    padding-bottom: 9px;
    border-bottom: 1px solid rgba(178, 212, 229, 0.14);
    color: var(--tech-label);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .plain-section-content > .plain-section-label:first-child {
    margin-top: 0;
  }

  .plain-products {
    margin: 24px 0 0;
    padding: 0;
    border-bottom: 1px solid rgba(178, 212, 229, 0.12);
    list-style: none;
  }

  .plain-products > li {
    padding: 20px 0;
    border-top: 1px solid rgba(178, 212, 229, 0.12);
  }

  .plain-product-heading {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 10px;
  }

  .plain-product-heading strong {
    color: var(--text-bright);
    font-size: 17px;
  }

  .plain-product-heading span {
    color: var(--tech-label);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .plain-products p,
  .plain-project-copy > p {
    margin: 7px 0 0;
    color: #aebfd7;
    line-height: 1.65;
  }

  .plain-stack-line {
    color: var(--text-dim) !important;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.035em;
  }

  .plain-section#elsewhere {
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
  }

  .plain-section#elsewhere .plain-section-rail-inner {
    position: static;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 10px 18px;
  }

  .plain-section#elsewhere .plain-section-rail p {
    margin: 0;
  }

  /* Wider than the 850px reading measure of the text sections, because a
     project row is copy plus a preview side by side and the preview needs
     room. Still capped: unbounded rows stretched the summaries past a
     comfortable line length on large monitors and left the section looking
     sparse. At 1100px the copy reads normally and the preview lands around
     400px wide. */
  .plain-section#elsewhere .plain-section-content {
    max-width: 1100px;
  }

  .plain-project {
    display: grid;
    grid-template-columns: minmax(300px, 1.12fr) minmax(280px, 0.88fr);
    gap: clamp(28px, 4vw, 52px);
    align-items: center;
    padding: 34px 0;
    border-top: 1px solid rgba(178, 212, 229, 0.12);
  }

  .plain-project-featured {
    grid-template-columns: minmax(380px, 1.5fr) minmax(280px, 0.7fr);
    padding: 40px 0 46px;
  }

  /* The columns swap with the row, not just the contents. Without this the
     template stayed `1.12fr 0.88fr` while the preview moved to column 2, so
     every alternating row rendered its screenshot ~20% narrower than the row
