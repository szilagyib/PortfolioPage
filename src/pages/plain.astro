---
/**
 * A semantic, continuous one-page portfolio for fast scanning.
 *
 * Content remains server-rendered and readable without JavaScript. The
 * interactive site's background is reused as a progressively enhanced
 * visual layer, while the document itself stays linear and accessible.
 */
import Base from '@/layouts/Base.astro';
import { AiChat } from '@/components/ai/AiChat';
import { CosmicBackground } from '@/components/canvas/CosmicBackground';
import { CvPill } from '@/components/canvas/CvPill';
import { doors } from '@/content/doors.data';
import { LAST_UPDATED_YEAR } from '@/content/site';
import type { ArtifactBlock } from '@/domain/artifact';
import type { DoorId } from '@/domain/door';
import '@/styles/global.css';

const DISPLAY_ORDER: readonly DoorId[] = [
  'about',
  'leadership',
  'engineering',
  'elsewhere',
];

const sections = DISPLAY_ORDER
  .map((id) => doors.find((door) => door.id === id))
  .filter((door): door is NonNullable<typeof door> => door !== undefined);

const profile = doors
  .find((door) => door.id === 'about')
  ?.artifact.find((block) => block.kind === 'profileHeader');

function toTitle(name: string): string {
  return name.charAt(0) + name.slice(1).toLowerCase();
}

function isExternal(href: string): boolean {
  return /^https?:/.test(href);
}

function contactDisplay(href: string): string {
  return href.replace(/^(https?:\/\/(www\.)?|mailto:)/, '');
}
---
<Base
  title="Borbála Szilágyi — Software Engineer · Team Lead"
  noindex
  canonicalPath="/"
>
  <style is:global>
    html {
      scroll-behavior: smooth;
      scroll-padding-top: 92px;
    }

    body {
      overflow-x: hidden !important;
      overflow-y: auto !important;
      min-height: 100dvh;
      background: #06060f;
    }
  </style>

  <div class="plain-space" aria-hidden="true">
    <CosmicBackground client:load />
  </div>

  <div class="plain-page">
    <a class="plain-skip" href="#profile">Skip to profile</a>

    <header class="plain-topbar">
      <div class="plain-topbar-inner">
        <a class="plain-brand" href="/" aria-label="Open interactive portfolio">
          <span class="plain-brand-name">Borbála Szilágyi</span>
          <span class="plain-brand-role">Software Engineer · Team Lead</span>
        </a>

        <nav class="plain-nav" aria-label="Page sections">
          {sections.map((section) => (
            <a class="plain-nav-section" href={`#${section.id}`}>
              {toTitle(section.name)}
            </a>
          ))}
          <a class="plain-nav-action plain-nav-ai" href="#ask-me">
            <span class="plain-nav-ai-dot" aria-hidden="true"></span>
            ask AI
          </a>
          <CvPill
            client:load
            className="all-doors-header-cv plain-nav-cv"
          />
          <a class="plain-nav-action plain-nav-interactive" href="/">
            interactive page ↗
          </a>
        </nav>
      </div>
    </header>

    <main class="plain-main">
      <section class="plain-hero" aria-labelledby="plain-title">
        <div class="plain-hero-copy">
          <h1 id="plain-title">Engineering systems.<br />Leading humans.</h1>
          <p class="plain-hero-deck">
            Software engineer and team lead building production systems,
            strong teams, and an honest place for AI-assisted development.
          </p>

          <form class="plain-hero-ask" data-hero-chat-jump>
            <label for="plain-hero-question">
              <span>ASK BORBÁLA_AI</span>
              <span id="plain-hero-question-hint">opens the live assistant</span>
            </label>
            <div class="plain-hero-ask-row">
              <input
                id="plain-hero-question"
                name="question"
                type="text"
                maxlength="250"
                autocomplete="off"
                placeholder="Ask about engineering, leadership, or AI…"
                aria-describedby="plain-hero-question-hint"
                required
              />
              <button type="submit">open chat ↓</button>
            </div>
          </form>

          {profile?.kind === 'profileHeader' && (
            <div class="plain-hero-contacts" aria-label="Contact links">
              {profile.contacts.map((contact) => (
                <a
                  href={contact.href}
                  aria-label={contact.label}
                  target={isExternal(contact.href) ? '_blank' : undefined}
                  rel={isExternal(contact.href) ? 'noopener noreferrer' : undefined}
                >
                  <span>{contact.label}</span>
                  <span aria-hidden="true">↗</span>
                </a>
              ))}
            </div>
          )}
        </div>

        {profile?.kind === 'profileHeader' && (
          <div class="plain-portrait-orbit" aria-hidden="true">
            <div class="plain-orbit plain-orbit-one"></div>
            <div class="plain-orbit plain-orbit-two"></div>
            <span class="plain-orbit-star plain-orbit-star-one"></span>
            <span class="plain-orbit-star plain-orbit-star-two"></span>
            <img
              src={profile.photo.src}
              alt=""
              width="220"
              height="220"
            />
          </div>
        )}
      </section>

      <section class="plain-ai-spotlight" id="ask-me" aria-labelledby="plain-ai-title">
        <div class="plain-ai-intro">
          <p class="plain-ai-kicker">
            <span class="plain-ai-live">
              <span aria-hidden="true"></span>
              live
            </span>
            portfolio assistant
          </p>
          <h2 id="plain-ai-title">Skip the résumé.<br />Ask the source.</h2>
          <p>
            Ask about my engineering work, leadership decisions, or how I use
            AI in production. Answers are grounded in this portfolio.
          </p>
        </div>

        <div class="plain-ai-console">
          <header class="plain-ai-console-header">
            <div>
              <span class="plain-ai-console-title">ASK BORBÁLA_AI</span>
              <span class="plain-ai-console-model">context-aware profile assistant</span>
            </div>
            <span class="plain-ai-console-status">
              <span aria-hidden="true"></span>
              ready
            </span>
          </header>

          <div class="plain-ai-console-body">
            <AiChat client:load />
          </div>

        </div>
      </section>

      <article class="plain-document" id="profile" aria-label="Professional profile">
        <div class="plain-document-readout" aria-hidden="true">
          <span>PROFILE / CONTINUOUS VIEW</span>
          <span>FULL PROFILE · LIVE DATA</span>
        </div>

        {sections.map((section) => (
          <section
            class="plain-section"
            id={section.id}
            aria-labelledby={`plain-h-${section.id}`}
          >
            <header class="plain-section-rail">
              <div class="plain-section-rail-inner">
                <h2 id={`plain-h-${section.id}`}>{toTitle(section.name)}</h2>
                <p>{section.tagline}</p>
              </div>
            </header>

            <div class="plain-section-content">
              {section.artifact.map((block: ArtifactBlock) => {
                if (
                  block.kind === 'aiChat'
                  || block.kind === 'profileHeader'
                  || block.kind === 'photo'
                ) {
                  return null;
                }

                if (block.kind === 'heading') {
                  return <h3 class="plain-heading">{block.text}</h3>;
                }

                if (block.kind === 'paragraph') {
                  return <p class="plain-copy">{block.text}</p>;
                }

                if (block.kind === 'bullet') {
                  return (
                    <ul class="plain-bullets">
                      {block.items.map((item) => <li>{item}</li>)}
                    </ul>
                  );
                }

                if (block.kind === 'metric') {
                  return (
                    <div class="plain-metric">
                      <strong>{block.value}</strong>
                      <span>{block.label}</span>
                    </div>
                  );
                }

                if (block.kind === 'quote') {
                  return (
                    <blockquote class="plain-quote">
                      {block.text}
                      {block.attribution && <footer>— {block.attribution}</footer>}
                    </blockquote>
                  );
                }

                if (block.kind === 'sectionLabel') {
                  return <h3 class="plain-section-label">{block.text}</h3>;
                }

                if (block.kind === 'productList') {
                  return (
                    <ul class="plain-products">
                      {block.products.map((product) => (
                        <li>
                          <div class="plain-product-heading">
                            <strong>{product.name}</strong>
                            <span>{product.type}</span>
                          </div>
                          <p>{product.summary}</p>
                          <p class="plain-stack-line">{product.stack.join(' · ')}</p>
                        </li>
                      ))}
                    </ul>
                  );
                }

                if (block.kind === 'projectCard') {
                  return (
                    <article class="plain-project">
                      {block.preview && (
                        <a
                          class="plain-project-preview"
                          href={block.href}
                          target={isExternal(block.href) ? '_blank' : undefined}
                          rel={isExternal(block.href) ? 'noopener noreferrer' : undefined}
                          tabindex="-1"
                          aria-hidden="true"
                        >
                          <img
                            src={block.preview.src}
                            alt=""
                            width="480"
                            height="270"
                            loading="lazy"
                          />
                        </a>
                      )}
                      <div class="plain-project-copy">
                        <div class="plain-project-heading">
                          <h4>
                            <a
                              href={block.href}
                              target={isExternal(block.href) ? '_blank' : undefined}
                              rel={isExternal(block.href) ? 'noopener noreferrer' : undefined}
                            >
                              {block.name} <span aria-hidden="true">↗</span>
                            </a>
                          </h4>
                          {block.liveHref && (
                            <a
                              class="plain-live-link"
                              href={block.liveHref}
                              target="_blank"
                              rel="noopener noreferrer"
                            >
                              live · {contactDisplay(block.liveHref)}
                            </a>
                          )}
                        </div>
                        <p>{block.summary}</p>
                        {block.stack && block.stack.length > 0 && (
                          <ul class="plain-stack" aria-label="Technology stack">
                            {block.stack.map((technology) => <li>{technology}</li>)}
                          </ul>
                        )}
                      </div>
                    </article>
                  );
                }

                if (block.kind === 'postCard') {
                  return (
                    <a
                      class="plain-post"
                      href={block.href}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <span class="plain-post-main">
                        <strong>{block.title}</strong>
                        <em>“{block.quote}”</em>
                      </span>
                      <span class="plain-post-meta">
                        {block.publication ? `${block.publication} · ` : ''}
                        {block.date} ↗
                      </span>
                    </a>
                  );
                }

                if (block.kind === 'contactGroup') {
                  return (
                    <ul class="plain-contact-list">
                      {block.contacts.map((contact) => (
                        <li>
                          <a
                            href={contact.href}
                            target={isExternal(contact.href) ? '_blank' : undefined}
                            rel={isExternal(contact.href) ? 'noopener noreferrer' : undefined}
                          >
                            {contactDisplay(contact.href)} ↗
                          </a>
                        </li>
                      ))}
                    </ul>
                  );
                }

                return null;
              })}
            </div>
          </section>
        ))}
      </article>

      <footer class="plain-footer">
        <span>updated · {LAST_UPDATED_YEAR}</span>
      </footer>
    </main>
  </div>
</Base>

<script>
  import { publishChatPrefill } from '@/services/chat-prefill';

  const heroChatForm =
    document.querySelector<HTMLFormElement>('[data-hero-chat-jump]');

  heroChatForm?.addEventListener('submit', (event) => {
    event.preventDefault();

    const data = new FormData(heroChatForm);
    const rawQuestion = data.get('question');
    if (typeof rawQuestion !== 'string') return;

    const question = rawQuestion.trim();
    if (!question) return;

    const target = document.querySelector<HTMLElement>('#ask-me');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    target?.scrollIntoView({
      behavior: reduceMotion ? 'auto' : 'smooth',
      block: 'start',
    });

    window.setTimeout(
      () => publishChatPrefill(question),
      reduceMotion ? 0 : 420,
    );
  });
</script>

<style>
  .plain-page {
    position: relative;
    z-index: 1;
    min-height: 100dvh;
    color: var(--text-bright);
  }

  .plain-space {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0.88;
  }

  .plain-space :global(astro-island) {
    position: absolute;
    inset: 0;
    display: block;
  }

  .plain-space::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(6, 6, 15, 0.05), rgba(6, 6, 15, 0.52)),
      radial-gradient(circle at 50% 48%, transparent 25%, rgba(6, 6, 15, 0.42) 100%);
  }

  .plain-skip {
    position: fixed;
    z-index: 100;
    top: 8px;
    left: 8px;
    padding: 8px 12px;
    color: var(--bg-deep);
    background: var(--accent-cyan);
    font-family: var(--font-mono);
    font-size: 11px;
    text-decoration: none;
    transform: translateY(-150%);
    transition: transform var(--d-fast) var(--ease-out);
  }

  .plain-skip:focus {
    transform: translateY(0);
  }

  .plain-topbar {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid rgba(178, 212, 229, 0.12);
    background:
      linear-gradient(
        180deg,
        rgba(6, 6, 15, 0.96) 0%,
        rgba(6, 6, 15, 0.84) 78%,
        rgba(6, 6, 15, 0.68) 100%
      );
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .plain-topbar-inner {
    width: min(100% - 40px, 1200px);
    min-height: 68px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
  }

  .plain-brand {
    display: flex;
    flex-direction: column;
    min-width: max-content;
    color: inherit;
    text-decoration: none;
  }

  .plain-brand-name {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.03em;
  }

  .plain-brand-role {
    margin-top: 3px;
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.08em;
  }

  .plain-nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 6px;
    font-family: var(--font-mono);
  }

  .plain-nav a {
    color: var(--text-dim);
    font-size: 10px;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition:
      color var(--d-fast) var(--ease-out),
      border-color var(--d-fast) var(--ease-out),
      background var(--d-fast) var(--ease-out);
  }

  .plain-nav-section {
    padding: 6px 8px;
  }

  .plain-nav a:hover {
    color: var(--text-bright);
  }

  .plain-nav-action {
    margin-left: 4px;
    padding: 6px 9px;
    border: 1px solid rgba(95, 184, 214, 0.34);
    border-radius: 4px;
    color: var(--accent-cyan) !important;
    background: rgba(13, 18, 48, 0.5);
  }

  .plain-nav-action:hover {
    border-color: rgba(178, 212, 229, 0.72);
    background: rgba(40, 52, 88, 0.66);
  }

  .plain-nav :global(.plain-nav-cv) {
    flex: 0 0 auto;
  }

  .plain-nav :global(.plain-nav-cv a) {
    font-size: inherit;
    letter-spacing: inherit;
  }

  .plain-nav-ai {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--accent-warm) !important;
    border-color: rgba(236, 200, 117, 0.5);
    background: rgba(236, 200, 117, 0.07);
    box-shadow: 0 0 16px rgba(236, 200, 117, 0.08);
  }

  .plain-nav-ai:hover {
    color: #ffe5a6 !important;
    border-color: rgba(236, 200, 117, 0.86);
    background: rgba(236, 200, 117, 0.14);
  }

  .plain-nav-ai-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent-warm);
    box-shadow: 0 0 8px var(--accent-warm);
    animation: plain-signal 2.4s ease-in-out infinite;
  }

  .plain-nav-interactive {
    color: #06131b !important;
    border-color: var(--accent-cyan);
    background: var(--accent-cyan);
    box-shadow: 0 0 18px rgba(95, 184, 214, 0.22);
    font-weight: 600;
  }

  .plain-nav-interactive:hover {
    color: #06131b !important;
    border-color: #a6e2f4;
    background: #83cbe3;
  }

  .plain-main {
    width: min(100% - 40px, 1200px);
    margin: 0 auto;
  }

  .plain-hero {
    min-height: calc(100svh - 68px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, min(30vw, 48svh, 390px));
    gap: clamp(28px, 6vw, 100px);
    align-items: center;
    padding: clamp(34px, 7svh, 80px) clamp(8px, 3vw, 36px);
  }

  .plain-hero-copy {
    max-width: 760px;
  }

  .plain-hero h1 {
    max-width: 780px;
    margin: 0;
    font-size: clamp(44px, min(7vw, 12svh), 92px);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.055em;
    text-wrap: balance;
    text-shadow: 0 0 36px rgba(178, 212, 229, 0.12);
  }

  .plain-hero-deck {
    max-width: 650px;
    margin: 22px 0 0;
    color: #9fb1cf;
    font-size: clamp(16px, 2vw, 21px);
    line-height: 1.65;
    text-wrap: balance;
  }

  .plain-hero-ask {
    max-width: 660px;
    margin: 22px 0 0;
    padding: 10px;
    border: 1px solid rgba(236, 200, 117, 0.38);
    border-radius: 9px;
    background:
      linear-gradient(135deg, rgba(236, 200, 117, 0.08), rgba(13, 18, 48, 0.68));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.04),
      0 0 24px rgba(236, 200, 117, 0.07);
    transition:
      border-color var(--d-fast) var(--ease-out),
      box-shadow var(--d-fast) var(--ease-out);
  }

  .plain-hero-ask:focus-within {
    border-color: rgba(236, 200, 117, 0.82);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 0 0 1px rgba(236, 200, 117, 0.08),
      0 0 32px rgba(236, 200, 117, 0.14);
  }

  .plain-hero-ask > label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 0 4px 8px;
    color: var(--accent-warm);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.1em;
  }

  .plain-hero-ask > label span:last-child {
    color: var(--text-dim);
    font-size: 8px;
    letter-spacing: 0.05em;
  }

  .plain-hero-ask-row {
    display: flex;
    align-items: stretch;
    gap: 8px;
  }

  .plain-hero-ask input {
    min-width: 0;
    min-height: 48px;
    flex: 1 1 auto;
    padding: 10px 12px;
    border: 1px solid rgba(178, 212, 229, 0.18);
    border-radius: 6px;
    outline: none;
    color: var(--text-bright);
    background: rgba(6, 8, 24, 0.76);
    font-family: var(--font-sans);
    font-size: var(--fs-input);
    line-height: 1.4;
  }

  .plain-hero-ask input::placeholder {
    color: #62708d;
  }

  .plain-hero-ask button {
    flex: 0 0 auto;
    padding: 10px 14px;
    border: 1px solid var(--accent-warm);
    border-radius: 6px;
    color: #181204;
    background: var(--accent-warm);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.04em;
    transition:
      background var(--d-fast) var(--ease-out),
      transform var(--d-fast) var(--ease-out);
  }

  .plain-hero-ask button:hover {
    transform: translateY(-1px);
    background: #ffe09a;
  }

  .plain-hero-contacts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    margin-top: 16px;
  }

  .plain-hero-contacts a {
    display: inline-flex;
    gap: 6px;
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .plain-hero-contacts a:hover {
    color: var(--accent-cyan);
  }

  .plain-portrait-orbit {
    position: relative;
    width: clamp(220px, min(29vw, 48svh), 390px);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    justify-self: end;
    filter: drop-shadow(0 0 48px rgba(95, 184, 214, 0.14));
  }

  .plain-portrait-orbit::before {
    content: '';
    position: absolute;
    width: 62%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: rgba(95, 184, 214, 0.12);
    filter: blur(28px);
  }

  .plain-portrait-orbit img {
    position: relative;
    z-index: 2;
    width: 56%;
    height: 56%;
    object-fit: cover;
    border: 1px solid rgba(178, 212, 229, 0.7);
    border-radius: 50%;
    box-shadow:
      0 0 0 8px rgba(13, 18, 48, 0.8),
      0 0 0 9px rgba(95, 184, 214, 0.18),
      0 0 46px rgba(95, 184, 214, 0.24);
  }

  .plain-orbit {
    position: absolute;
    z-index: 1;
    border: 1px solid rgba(95, 184, 214, 0.22);
    border-radius: 50%;
  }

  .plain-orbit-one {
    inset: 9%;
    border-left-color: rgba(236, 200, 117, 0.7);
    animation: plain-orbit-spin 26s linear infinite;
  }

  .plain-orbit-two {
    inset: 0;
    border-top-color: rgba(178, 212, 229, 0.55);
    border-bottom-color: transparent;
    animation: plain-orbit-spin 42s linear infinite reverse;
  }

  .plain-orbit-star {
    position: absolute;
    z-index: 3;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent-warm);
    box-shadow: 0 0 12px var(--accent-warm);
  }

  .plain-orbit-star-one {
    top: 17%;
    right: 15%;
  }

  .plain-orbit-star-two {
    bottom: 8%;
    left: 39%;
    width: 3px;
    height: 3px;
    background: var(--accent-cyan);
    box-shadow: 0 0 10px var(--accent-cyan);
  }

  .plain-ai-spotlight {
    position: relative;
    display: grid;
    grid-template-columns: minmax(260px, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
    margin: 0 0 28px;
    padding: clamp(28px, 4vw, 52px);
    overflow: hidden;
    border: 1px solid rgba(236, 200, 117, 0.34);
    border-radius: 18px;
